{
  "name": "previewhost-multi-repo-example",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "previewhost serve --root . --allow-exec --data-dir .local/data --token-file .local/token",
    "start": "previewhost start --file environment.yaml --token-file .local/token",
    "replace": "previewhost replace --file environment.yaml --token-file .local/token",
    "status": "previewhost get shared-notes --token-file .local/token",
    "stop": "previewhost stop shared-notes --token-file .local/token",
    "delete-data": "previewhost delete-data shared-notes --token-file .local/token",
    "shutdown": "previewhost shutdown --token-file .local/token"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  }
}
