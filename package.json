{
  "name": "previewhost",
  "version": "0.1.0-alpha.1",
  "description": "Local HTTP previews for applications and coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "previewhost": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/native/keychain",
    "examples/static.json",
    "examples/command.json",
    "examples/server.mjs",
    "examples/site/index.html",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-bin.mjs && node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/build-native.mjs --test && node --test --test-reporter=tap --test-concurrency=1 .local/test-build/*.test.js examples/multi-repo/*.test.mjs scripts/*.test.mjs",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test",
    "verify:release": "node scripts/verify-release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version:release": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RojhatToptamus/previewhost.git"
  }
}
