{
  "name": "previewhost",
  "version": "0.3.1",
  "description": "Run apps and services in local preview environments with stable URLs.",
  "keywords": [
    "local-preview",
    "preview-environment",
    "local-development",
    "dev-server",
    "preview",
    "cli",
    "mcp",
    "coding-agents",
    "ai-agents",
    "worktrees",
    "localhost"
  ],
  "homepage": "https://previewhost.app",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "previewhost": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/native/keychain",
    "dist/fonts",
    "dist/dashboard",
    "dist/ui-tokens.css",
    "dist/previewhost.svg",
    "dist/favicon.png",
    "dist/skills/previewhost",
    "examples/static.json",
    "examples/command.json",
    "examples/server.mjs",
    "examples/site/index.html",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node scripts/prepare-bin.mjs && node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit && tsc -p dashboard/tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/build-native.mjs --test && node --test --test-reporter=tap --test-concurrency=1 .local/test-build/*.test.js examples/multi-repo/*.test.mjs scripts/*.test.mjs",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test",
    "verify:release": "node scripts/verify-release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "changeset": "changeset",
    "version:release": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "build:dashboard": "vite build",
    "test:dashboard": "npm run build && playwright test --config dashboard/playwright.config.ts",
    "dev:docs": "vite --config website/vite.config.mjs",
    "build:docs": "node website/build.mjs",
    "preview:docs": "vite preview --config website/vite.config.mjs",
    "check:docs": "tsc -p website/tsconfig.json && npm run build:docs && node website/check.mjs",
    "test:docs": "playwright test --config website/playwright.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "koffi": "^3.3.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "marked": "^18.0.13",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RojhatToptamus/previewhost.git"
  }
}
