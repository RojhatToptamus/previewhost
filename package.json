{
  "name": "previewd",
  "version": "0.1.0",
  "description": "Local HTTP previews for applications and coding agents.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "previewd": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "!examples/**/*.test.mjs",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/prepare-bin.mjs && node scripts/build-native.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/build-native.mjs --test && node --test --test-concurrency=1 .local/test-build/*.test.js examples/multi-repo/*.test.mjs",
    "prepack": "npm run build",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
